# Database
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/chplay_api

# Qdrant Vector Database
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=documents
QDRANT_TIMEOUT=30

# LLM / AI
GEMINI_API_KEY=your_gemini_api_key_here
LITELLM_API_KEY=
LITELLM_API_BASE=
ZAI_API_KEY=your_zai_api_key_here  # Z.AI (Zhipu AI) — GLM models, prefix zai/
LITELLM_MODEL=zai/glm-4.7-flash
LITELLM_FALLBACK_MODELS=
LITELLM_TIMEOUT=60
LITELLM_MAX_RETRIES=3

# PhoBERT (deployed on Google Colab)
PHOBERT_API_URL=
PHOBERT_API_KEY=
PHOBERT_TIMEOUT=30
PHOBERT_MAX_RETRIES=3
PHOBERT_BATCH_SIZE=32

# Embedding
EMBEDDING_API_URL=http://localhost:8001/v1/embeddings
EMBEDDING_API_KEY=
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSION=1024
EMBEDDING_BATCH_SIZE=32
EMBEDDING_MAX_RETRIES=3
EMBEDDING_TIMEOUT=60

# Hybrid Search
HYBRID_SEARCH_WEIGHT_VECTOR=0.5
HYBRID_SEARCH_WEIGHT_BM25=0.5
HYBRID_SEARCH_TOP_K=10

# Chunking
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# Retry & Timeout
RETRY_ATTEMPTS=3
TIMEOUT_SECONDS=30

# Spark
SPARK_MASTER=local[*]
SPARK_APP_NAME=chplay-api

# Scheduler
SCHEDULER_ENABLED=false
SCHEDULER_TIMEZONE=Asia/Ho_Chi_Minh

# Ticket (IT Helpdesk / Trello)
TICKET_PROVIDER=http
TICKET_API_URL=
TICKET_API_KEY=
TICKET_TIMEOUT=30
TICKET_MAX_RETRIES=3

# Trello (chỉ dùng khi TICKET_PROVIDER=trello)
# ── Cách lấy từng giá trị (xem hướng dẫn chi tiết trong plan PHASE 1) ──
# 1) TRELLO_API_KEY: https://trello.com/power-ups/admin → chọn team → tạo Power-Up
#    (API key là chuỗi 32 ký tự, cấp miễn phí)
# 2) TRELLO_API_TOKEN: mở link sau (thay KEY bằng API key ở trên):
#    https://trello.com/1/authorize?expiration=never&scope=read,write,account&response_type=token&key=KEY
#    → click "Allow" → copy token (chuỗi 64 ký tự)
# 3) TRELLO_LIST_ID: id của LIST chứa card trong board AI Tickets:
#    curl "https://api.trello.com/1/boards/VbxJyXU9/lists?key=KEY&token=TOKEN"
#    → copy field "id" của list muốn chứa ticket (vd "To Do")
TRELLO_API_KEY=
TRELLO_API_TOKEN=
TRELLO_LIST_ID=
# Board Trello đích chứa card ticket (case daily)
TRELLO_BOARD_URL=https://trello.com/b/VbxJyXU9/ai-tickets

# Issue Proposal
# Mỗi cụm topic = 1 ticket, không giới hạn số review
PROPOSAL_MIN_REVIEWS=1
PROPOSAL_DETECT_CRON_HOUR=7
PROPOSAL_PROCESS_INTERVAL_SECONDS=60
PROPOSAL_BATCH_SIZE=20

# App
APP_NAME=chplay-api
APP_VERSION=0.1.0
DEBUG=true
LOG_LEVEL=INFO
GEMINI_MODEL=gemini-3.5-flash
REVIEW_REPLY_BATCH_SIZE=20
REVIEW_REPLY_MAX_LENGTH=1000

# Auth0
AUTH0_DOMAIN=your-tenant.auth0.com
AUTH0_AUDIENCE=http://localhost:8000

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://githubanhduonguit.github.io
