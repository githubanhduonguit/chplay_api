# Database
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/chplay_api

# Qdrant Vector Database
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# LLM / AI
GEMINI_API_KEY=your_gemini_api_key_here
LITELLM_API_KEY=your_litellm_key_here
LITELLM_API_BASE=https://api.litellm.ai

# PhoBERT (deployed on Google Colab)
PHOBERT_API_URL=http://your-colab-url.ngrok.io/predict
PHOBERT_API_KEY=

# Embedding
EMBEDDING_API_URL=http://localhost:8001/v1/embeddings
EMBEDDING_API_KEY=
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSION=1024
EMBEDDING_BATCH_SIZE=32
EMBEDDING_MAX_RETRIES=3
EMBEDDING_TIMEOUT=60

# Hybrid Search
HYBRID_SEARCH_WEIGHT_VECTOR=0.5
HYBRID_SEARCH_WEIGHT_BM25=0.5
HYBRID_SEARCH_TOP_K=10

# Retry & Timeout
RETRY_ATTEMPTS=3
TIMEOUT_SECONDS=30

# Spark
SPARK_MASTER=local[*]
SPARK_APP_NAME=chplay-api

# App
APP_NAME=chplay-api
APP_VERSION=0.1.0
DEBUG=true
LOG_LEVEL=INFO
