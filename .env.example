# Database
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/chplay_api

# Qdrant Vector Database
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=documents
QDRANT_TIMEOUT=30

# LLM / AI
GEMINI_API_KEY=your_gemini_api_key_here
LITELLM_API_KEY=
LITELLM_API_BASE=
LITELLM_MODEL=gemini/gemini-3.5-flash
LITELLM_FALLBACK_MODELS=
LITELLM_TIMEOUT=60
LITELLM_MAX_RETRIES=3

# PhoBERT (deployed on Google Colab)
PHOBERT_API_URL=
PHOBERT_API_KEY=
PHOBERT_TIMEOUT=30
PHOBERT_MAX_RETRIES=3
PHOBERT_BATCH_SIZE=32

# Embedding
EMBEDDING_API_URL=http://localhost:8001/v1/embeddings
EMBEDDING_API_KEY=
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSION=1024
EMBEDDING_BATCH_SIZE=32
EMBEDDING_MAX_RETRIES=3
EMBEDDING_TIMEOUT=60

# Hybrid Search
HYBRID_SEARCH_WEIGHT_VECTOR=0.5
HYBRID_SEARCH_WEIGHT_BM25=0.5
HYBRID_SEARCH_TOP_K=10

# Chunking
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# Retry & Timeout
RETRY_ATTEMPTS=3
TIMEOUT_SECONDS=30

# Spark
SPARK_MASTER=local[*]
SPARK_APP_NAME=chplay-api

# Scheduler
SCHEDULER_ENABLED=false
SCHEDULER_TIMEZONE=Asia/Ho_Chi_Minh

# App
APP_NAME=chplay-api
APP_VERSION=0.1.0
DEBUG=true
LOG_LEVEL=INFO
GEMINI_MODEL=gemini-3.5-flash
REVIEW_REPLY_BATCH_SIZE=20
REVIEW_REPLY_MAX_LENGTH=1000
