# =============================================================================
#  .env.codespaces — Cau hinh moi truong chay tren GitHub Codespaces / deploy
# =============================================================================
#  CACH DUNG (trong Codespace):
#    1. cp .env.codespaces .env
#    2. Dien cac API key that vao .env (khong duoc commit - repo nay PUBLIC)
#
#  ⚠️  TUYET DOI KHONG dien secret that vao file nay roi commit.
#      File nay nam trong git (repo PUBLIC); chi chua config mac dinh.
#      Secret nen dat trong .env (gitignored) hoac Codespaces secrets
#      (Settings -> Secrets and variables -> Codespaces) - pydantic doc env var
#      voi uu tien cao hon file .env.
# =============================================================================

# --- App ------------------------------------------------------------------
APP_NAME=chplay-api
APP_VERSION=0.1.0
DEBUG=false          # doi true neu muon log chi tiet khi debug
LOG_LEVEL=INFO

# --- Database (Neon) ------------------------------------------------------
# ⚠️  Dang chua password cu - sau khi xoay (rotate) password Neon hay cap nhat
#     ca file nay lan .env

# --- Qdrant (vector DB) ----------------------------------------------------
# Chay Qdrant ngay trong Codespace:
#     docker run -d -p 6333:6333 -p 6334:6334 qdrant/qdrant
# Hoac tro toi Qdrant Cloud da deploy
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=documents
QDRANT_TIMEOUT=30

# --- LLM / AI --------------------------------------------------------------
GEMINI_API_KEY=          # dien vao .env
LITELLM_API_KEY=         # dien vao .env (uu tien hon ZAI_API_KEY)
LITELLM_API_BASE=https://api.litellm.ai
ZAI_API_KEY=             # dien vao .env (GLM models, prefix zai/)
LITELLM_MODEL=zai/glm-4.7-flash
GEMINI_MODEL=gemini-3.5-flash
LITELLM_FALLBACK_MODELS=
LITELLM_TIMEOUT=60
LITELLM_MAX_RETRIES=3

# --- PhoBERT (deploy tren Google Colab - xem .scripts/phobert-colab-guide.md)
PHOBERT_API_URL=
PHOBERT_API_KEY=
PHOBERT_TIMEOUT=30
PHOBERT_MAX_RETRIES=3
PHOBERT_BATCH_SIZE=32

# --- Embedding --------------------------------------------------------------
# EMBEDDING_PROVIDER: "openai" (endpoint OpenAI-compatible, vi du TEI/Ollama)
#                     hoac "gemini" (Google Gemini embedContent API)
EMBEDDING_PROVIDER=openai
EMBEDDING_API_URL=http://localhost:8001/v1/embeddings
EMBEDDING_API_KEY=
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSION=1024
EMBEDDING_BATCH_SIZE=32
EMBEDDING_MAX_RETRIES=3
EMBEDDING_TIMEOUT=60

# --- Hybrid Search -----------------------------------------------------------
HYBRID_SEARCH_WEIGHT_VECTOR=0.5
HYBRID_SEARCH_WEIGHT_BM25=0.5
HYBRID_SEARCH_TOP_K=10

# --- Retry & Timeout ----------------------------------------------------------
RETRY_ATTEMPTS=3
TIMEOUT_SECONDS=30
REVIEW_REPLY_BATCH_SIZE=20
REVIEW_REPLY_MAX_LENGTH=1000

# --- Spark ---------------------------------------------------------------------
SPARK_MASTER=local[*]
SPARK_APP_NAME=chplay-api

# --- Web Search (Google Custom Search - mac dinh TAT) ---------------------------
WEB_SEARCH_ENABLED=false
WEB_SEARCH_PROVIDER=google_custom_search
WEB_SEARCH_API_KEY=       # dien vao .env neu bat
WEB_SEARCH_ENGINE_ID=     # dien vao .env neu bat (Google CSE id cx)
WEB_SEARCH_TIMEOUT=15
WEB_SEARCH_TOP_K=5
WEB_SEARCH_MIN_RAG_SCORE=0.3
WEB_SEARCH_LANGUAGE=lang_vi
WEB_SEARCH_SAFE_SEARCH=active

# --- Chunking ---------------------------------------------------------------------
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# --- Scheduler ---------------------------------------------------------------------
SCHEDULER_ENABLED=false
SCHEDULER_TIMEZONE=Asia/Ho_Chi_Minh

# --- Paths --------------------------------------------------------------------------
UPLOAD_DIR=uploads
DATA_DIR=data
